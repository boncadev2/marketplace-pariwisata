APP_NAME=Laravel
SANDBOX_PAYMENT_WEBHOOK_SECRET=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
TRANSACTION_NOTICES_ENABLED=false
PAYMENT_RECONCILIATION_REQUESTS_PER_MINUTE=30
PUBLIC_CATALOG_CACHE_SECONDS=300
PUBLIC_BROWSER_CACHE_SECONDS=60
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
HEALTH_MINIMUM_FREE_DISK_BYTES=536870912
HEALTH_FAILED_JOBS_THRESHOLD=10
HEALTH_REQUIRE_SCHEDULER=false
HEALTH_SCHEDULER_STALE_SECONDS=180

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
PRIVACY_SESSION_RETENTION_DAYS=30
PRIVACY_NOTIFICATION_DATA_DAYS=90
PRIVACY_SUPPORT_ATTACHMENT_DAYS=365

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SANDBOX_REFUND_ENABLED=false
PILOT_CHECKOUT_ENABLED=false
PILOT_DEMO_PASSWORD=

# sandbox internal (default) atau midtrans_sandbox
PAYMENT_GATEWAY=sandbox
MIDTRANS_SERVER_KEY=

PARTNER_SELF_REGISTRATION=true

# Activation flags remain off until staging and merchant verification complete.
MIDTRANS_PRODUCTION_ENABLED=false
MIDTRANS_PRODUCTION_SERVER_KEY=
MIDTRANS_WEBHOOK_URL=
COMMERCE_PRODUCTION_ENABLED=false
REFUND_DRIVER=sandbox
MIDTRANS_REFUNDS_ENABLED=false
SHIPPING_DRIVER=manual
SHIPPING_PROVIDER_ENABLED=false
BITESHIP_API_KEY=
SHIPPING_COURIERS=jne,sicepat,anteraja

# SMTP credentials stay here; Docker MAIL_HOST/MAIL_PORT overrides are in root .env.
MAIL_TIMEOUT=15
# For port 465 use MAIL_SCHEME=smtps. For STARTTLS (commonly 587), use smtp.
# Set MAIL_FROM_ADDRESS to the sender verified by your email provider.
# Keep SHIPPING_PROVIDER_ENABLED=false until Biteship account and API key are ready.
