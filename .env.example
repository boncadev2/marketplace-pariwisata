# Docker Compose development settings. Do not add credentials to this file.
APP_NAME="Wisata Daerah"
APP_ENV=local
APP_DEBUG=true
APP_PORT=8080
FRONTEND_PORT=3000
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_PORT=8025

MYSQL_DATABASE=wisata_daerah
MYSQL_USER=wisata_daerah
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# Public URLs and mail can be overridden for a deployment with a TLS endpoint.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
SESSION_SECURE_COOKIE=false
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
